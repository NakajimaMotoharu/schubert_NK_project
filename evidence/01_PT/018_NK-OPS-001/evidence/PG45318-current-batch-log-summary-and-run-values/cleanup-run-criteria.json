  "independentCaseMap": [
    {
      "method": "summaryUsesFixedDeltasAndCumulativeWarning",
      "testId": "PT-BAT-CLEANVALUE003",
      "expected": "7/4/3 attempt, 10/5/5 cumulative, 10 on skipped; empty/Long.MAX_VALUE produce exit 0; no run identity in diagnostic"
    },
    {
      "method": "summaryRejectsEachInvalidComponent",
      "testId": "PT-BAT-CLEANVALUE004",
      "expected": "Nulls, mismatched run, incomplete progress, each independently regressed target/deleted/skipped"
    },
    {
      "method": "progressRetainsValuesAndRejectsNulls",
      "testId": "PT-BAT-CLEANVALUE005",
      "expected": "Fixed counts and run with explicit complete flag; reject null at boundary"
    },
    {
      "method": "chunkRequiresZeroCountsForEveryRejectedReason",
      "testId": "PT-BAT-CLEANVALUE006",
      "expected": "Fixed three reasons; only OK accepts non-zero in rejected chunk fixture"
    },
    {
      "method": "cutoffBoundsNullsAndFixedRunDiagnostic",
      "testId": "PT-BAT-RUNVALUE001",
      "expected": "AD 0001 through 9999 at microsecond precision, below/above/precision/null rejected; fixed redacted string"
    },
    {
      "method": "activationNullsValueAccessorsAndFixedDiagnostic",
      "testId": "PT-BAT-RUNVALUE002",
      "expected": "UTC 15:00 maps to next Tokyo date; identity not logged; nulls rejected"
    },
    {
      "method": "countsAcceptExactBoundsAndRejectEachInconsistentComponent",
      "testId": "PT-BAT-CLEANVALUE001",
      "expected": "Use fixed nine invalid and six valid count arrays, including overflow and Long.MAX_VALUE"
    }
  ],
