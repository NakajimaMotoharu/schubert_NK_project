          "body": "{\n        if (!(value instanceof FieldValue.Flag flag)) {\n          throw new MessageEncodingException(\"boolean payload field has the wrong Java type\");\n        }\n        yield FieldCodec.encodeBoolean(flag.value(), false);\n      }"
