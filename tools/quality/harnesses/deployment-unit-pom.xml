<?xml version="1.0" encoding="UTF-8"?>
<!-- Pure text-source contract PT, no production executable dependency or service operation. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.codex.schubert</groupId><artifactId>schubert-nk</artifactId>
    <version>0.1.0-SNAPSHOT</version><relativePath>../../../pom.xml</relativePath></parent>
  <artifactId>deployment-unit-contract-pt</artifactId>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.4</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${project.basedir}/target-deployment-unit</directory>
    <sourceDirectory>${project.basedir}/empty-main</sourceDirectory>
    <testSourceDirectory>${project.basedir}/../../../src/schubert-nk-batch/src/test/java</testSourceDirectory>
    <testResources><testResource>
      <directory>${project.basedir}/../../../src/deployment/systemd</directory>
      <targetPath>systemd</targetPath>
      <includes>
        <include>schubert-nk-backup.service.template</include>
        <include>schubert-nk-bootstrap-admin.service.template</include>
        <include>caddy.service.d/schubert-nk-startup-policy.conf</include>
        <include>caddy.service.d/schubert-nk-stop-policy.conf</include>
      </includes>
    </testResource></testResources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version>
        <configuration><showWarnings>true</showWarnings><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
          <testIncludes><testInclude>dev/codex/schubert/nk/batch/platform/SupplementaryUnitTemplateTest.java</testInclude></testIncludes>
        </configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
        <configuration><failIfNoTests>true</failIfNoTests><redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables><user.language>ja</user.language><user.country>JP</user.country><user.timezone>Asia/Tokyo</user.timezone></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
