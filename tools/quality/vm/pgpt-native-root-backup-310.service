# NATIVE026/SSC093: isolated VM-only read-only M/A and cold backup observation.
# Fixed subject identity, not a Production morning controller or gate waiver.
[Unit]
Description=PGPT native root backup termination probe
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/pgpt-native/PG310
ExecStart=/opt/jdk-25.0.4/bin/java --enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8 -cp /opt/pgpt-native/PG310/classes:/opt/pgpt-native/PG310/batch.jar:/opt/pgpt-native/PG309/bootstrap.jar:/opt/pgpt-native/classes:/opt/pgpt-native/lib/* NativeRootBackupTerminationProbe
Restart=no
RemainAfterExit=yes
TimeoutStartSec=60s
TimeoutStopSec=60s
KillMode=control-group
SendSIGKILL=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
