[Unit]
Description=PGPT isolated Production backup copy probe (not Production morning)
After=postgresql.service

[Service]
Type=oneshot
User=schubert-backup
Group=schubert-backup
LoadCredential=backup-pgpass:/etc/schubert-nk/credentials/backup-pgpass
RuntimeDirectory=pgpt-backup-308
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/jdk-25.0.4/bin/java --enable-native-access=ALL-UNNAMED -cp /opt/pgpt-native/PG308/classes:/opt/pgpt-native/classes:/opt/pgpt-native/lib/* NativeBackupCopyProbe
TimeoutStartSec=30min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=no
ProtectSystem=strict
ReadWritePaths=/srv/schubert-nk/backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
