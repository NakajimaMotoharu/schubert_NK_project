[Unit]
Description=PGPT isolated native017 canonical API child probe (NOT production)
[Service]
Type=oneshot
User=schubert-api
Group=schubert-api
SupplementaryGroups=schubert schubert-read schubert-web
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
ReadWritePaths=/var/lib/schubert-nk/pgpt-native-api
ExecStart=!/usr/bin/java --enable-native-access=ALL-UNNAMED -cp /opt/pgpt-native/classes:/opt/pgpt-native/lib/* NativeCanonicalChildProbe API
