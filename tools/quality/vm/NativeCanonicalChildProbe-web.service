[Unit]
Description=PGPT isolated native017 canonical Web child probe (NOT production)
[Service]
Type=oneshot
User=schubert-web
Group=schubert-web
SupplementaryGroups=schubert schubert-read
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
ReadWritePaths=/var/lib/schubert-nk/pgpt-native-web
ExecStart=!/usr/bin/java --enable-native-access=ALL-UNNAMED -cp /opt/pgpt-native/classes:/opt/pgpt-native/lib/* NativeCanonicalChildProbe WEB
