# PT-OPS-NATIVE-007; isolated test unit, NOT schubert-nk-api.service or readiness gate.
[Unit]
Description=PGPT API inherited admission lock feasibility
After=postgresql.service
[Service]
Type=oneshot
User=schubert-api
Group=schubert-api
SupplementaryGroups=schubert schubert-read schubert-web
LoadCredential=db-api:/etc/schubert-nk/credentials/db-api
LoadCredential=mq-api:/etc/schubert-nk/credentials/mq-api
LoadCredential=api-context-aes-current:/etc/schubert-nk/credentials/api-context-aes-current
LoadCredential=api-inbox-response-aes-current:/etc/schubert-nk/credentials/api-inbox-response-aes-current
LoadCredential=operation-hmac-current:/etc/schubert-nk/credentials/operation-hmac-current
ExecStart=!/bin/bash /opt/pgpt-native/source/tools/quality/vm/044_inherited_lock.sh api
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
