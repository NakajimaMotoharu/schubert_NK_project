# NK-OPS-001; RD SYS/DAT/PER; UI212/253; SS342 section6; SSC069/PG187.
# PT-OPS-PGCFG-001/002/005/006/008. No secrets. Merge with deployment paths.
# This template does not certify primary error MESSAGE redaction or host readiness.
listen_addresses = '127.0.0.1,::1'
port = 5432
max_connections = 40
shared_buffers = '2GB'
effective_cache_size = '6GB'
work_mem = '8MB'
maintenance_work_mem = '512MB'
max_worker_processes = 8
max_parallel_workers = 4
max_parallel_workers_per_gather = 2
temp_file_limit = '2GB'
wal_compression = on
min_wal_size = '1GB'
max_wal_size = '4GB'
checkpoint_timeout = '15min'
checkpoint_completion_target = 0.9
deadlock_timeout = '500ms'
password_encryption = 'scram-sha-256'
ssl = off
log_statement = 'none'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_connections = on
log_disconnections = on
log_checkpoints = on
log_lock_waits = on
log_autovacuum_min_duration = 0
log_min_duration_statement = -1
log_min_duration_sample = -1
log_transaction_sample_rate = 0
log_min_error_statement = 'panic'
log_error_verbosity = 'terse'
