# NK-OPS-001/NK-MQ-001; SYS-002/004, OPS-009; UI251/253; SS321/341/342/343; SSC103.
# Real vendor instance. Missing Cleanup/source credential is a start failure, never a bypass.
[Unit]
Description=Schubert NK Artemis broker
After=schubert-nk-cleanup.service
Requires=schubert-nk-cleanup.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=schubert-artemis
Group=schubert-artemis
WorkingDirectory=/var/lib/schubert-nk/artemis
LoadCredential=artemis-users:/etc/schubert-nk/credentials/artemis-users
BindReadOnlyPaths=/run/credentials/artemis.service/artemis-users:/var/lib/schubert-nk/artemis/etc/artemis-users.properties
Environment="JAVA_ARGS=-Xms768m -Xmx1024m -XX:MaxDirectMemorySize=256m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=UTC"
UnsetEnvironment=JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS CLASSPATH LD_PRELOAD LD_LIBRARY_PATH
ExecStart=/var/lib/schubert-nk/artemis/bin/artemis run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=60s
KillMode=control-group
SendSIGKILL=no
MemoryMax=2048M
LimitNOFILE=65536
ReadWritePaths=/var/lib/schubert-nk/artemis/data /var/lib/schubert-nk/artemis/log /var/lib/schubert-nk/artemis/tmp /var/lib/schubert-nk/artemis/lock
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
