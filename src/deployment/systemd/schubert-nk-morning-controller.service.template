# NK-OPS-001; OPS009/UI251; SS341/342/343; SSC094/100-102; PG339/BUG316.
# Read-only fail-closed candidate. Do not install/enable as the operational Morning controller
# until continuous M/A, fixed-eight stop, backup/Cleanup, journal, permit and exit contracts pass.
[Unit]
Description=Schubert NK Morning root controller (fail-closed PGPT candidate)
After=postgresql.service
Requires=postgresql.service
Before=schubert-nk-backup.service schubert-nk-cleanup.service artemis.service schubert-nk-expiry-cleanup.service schubert-nk-api.service schubert-nk-web.service caddy.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/schubert-nk/current/operations
UnsetEnvironment=JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS CLASSPATH LD_PRELOAD LD_LIBRARY_PATH
LoadCredential=db-batch:/etc/schubert-nk/credentials/db-batch
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8 -Duser.timezone=UTC -XX:+ExitOnOutOfMemoryError -Xms128m -Xmx512m -XX:MaxDirectMemorySize=64m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=128m -cp /opt/schubert-nk/current/operations/batch.jar:/opt/schubert-nk/current/operations/lib/* dev.codex.schubert.nk.batch.file.MorningProcessMain
Restart=no
TimeoutStartSec=30min
TimeoutStopSec=60s
KillMode=control-group
SendSIGKILL=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1024M
LimitNOFILE=65536
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
