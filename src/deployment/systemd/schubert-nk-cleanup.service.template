# NK-OPS-001/NK-BAT-001; OPS009/BAK001/UI251; SS341/342/343; SSC104/PG334.
# Fail-closed provisional real entry. Do not install/enable until parent M/A, DELETE, transfer,
# full terminal and exit 0/10 contracts are complete and independently verified.
[Unit]
Description=Schubert NK root cleanup child (fail-closed PGPT candidate)
After=postgresql.service schubert-nk-backup.service
Requires=postgresql.service
Before=artemis.service schubert-nk-api.service schubert-nk-web.service caddy.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/schubert-nk/current/operations
UnsetEnvironment=JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS CLASSPATH LD_PRELOAD LD_LIBRARY_PATH
LoadCredential=cleanup-request:/run/schubert-nk/cleanup-request/cleanup-request
LoadCredential=db-batch:/etc/schubert-nk/credentials/db-batch
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -Dfile.encoding=UTF-8 -Duser.timezone=UTC -XX:+ExitOnOutOfMemoryError -Xms128m -Xmx512m -XX:MaxDirectMemorySize=64m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=128m -cp /opt/schubert-nk/current/operations/batch.jar:/opt/schubert-nk/current/operations/lib/* dev.codex.schubert.nk.batch.file.CleanupProcessMain
Restart=no
RemainAfterExit=yes
TimeoutStartSec=30min
TimeoutStopSec=60s
KillMode=control-group
SendSIGKILL=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1024M
LimitNOFILE=65536
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
