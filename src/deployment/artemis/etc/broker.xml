  <core xmlns="urn:activemq:core">
    <name>schubert-nk-broker</name>
    <persistence-enabled>true</persistence-enabled>
    <graceful-shutdown-enabled>true</graceful-shutdown-enabled>
    <graceful-shutdown-timeout>60000</graceful-shutdown-timeout>
    <resolve-protocols>false</resolve-protocols>
    <journal-type>NIO</journal-type>
    <paging-directory>data/paging</paging-directory>
    <bindings-directory>data/bindings</bindings-directory>
    <journal-directory>data/journal</journal-directory>
    <large-messages-directory>data/large-messages</large-messages-directory>
    <journal-datasync>true</journal-datasync>
    <journal-file-size>10MiB</journal-file-size>
    <journal-min-files>4</journal-min-files>
    <journal-pool-files>20</journal-pool-files>
    <journal-compact-percentage>30</journal-compact-percentage>
    <journal-compact-min-files>10</journal-compact-min-files>
    <global-max-messages>50000</global-max-messages>
    <global-max-size>512MiB</global-max-size>
    <max-disk-usage>90</max-disk-usage>
    <disk-scan-period>5000</disk-scan-period>
    <id-cache-size>20000</id-cache-size>
    <persist-id-cache>true</persist-id-cache>

    <acceptors>
      <acceptor name="core">tcp://127.0.0.1:61616?protocols=CORE</acceptor>
    </acceptors>

    <security-settings>
      <security-setting match="nk.sync.request">
        <permission type="send" roles="nk_web"/>
        <permission type="consume" roles="nk_api"/>
        <permission type="browse" roles="nk_ops"/>
      </security-setting>
      <security-setting match="nk.sync.reply.web">
        <permission type="consume" roles="nk_web"/>
        <permission type="send" roles="nk_api"/>
        <permission type="browse" roles="nk_ops"/>
      </security-setting>
      <security-setting match="nk.async.work">
        <permission type="send" roles="nk_api,nk_ops"/>
        <permission type="consume" roles="nk_api"/>
        <permission type="browse" roles="nk_ops"/>
      </security-setting>
      <security-setting match="nk.web.log">
        <permission type="send" roles="nk_web"/>
        <permission type="consume" roles="nk_api"/>
        <permission type="browse" roles="nk_ops"/>
      </security-setting>
      <security-setting match="nk.dead.letter">
        <permission type="send" roles="nk_web,nk_api"/>
        <permission type="consume" roles="nk_ops"/>
        <permission type="browse" roles="nk_ops"/>
        <permission type="manage" roles="nk_ops"/>
      </security-setting>
      <security-setting match="nk.expiry">
        <permission type="consume" roles="nk_mq_maintenance,nk_ops"/>
        <permission type="browse" roles="nk_mq_maintenance,nk_ops"/>
        <permission type="manage" roles="nk_ops"/>
      </security-setting>
      <security-setting match="activemq.management.#">
        <permission type="manage" roles="nk_ops"/>
        <permission type="send" roles="nk_ops"/>
        <permission type="consume" roles="nk_ops"/>
        <permission type="createAddress" roles="nk_ops"/>
        <permission type="deleteAddress" roles="nk_ops"/>
        <permission type="createNonDurableQueue" roles="nk_ops"/>
        <permission type="deleteNonDurableQueue" roles="nk_ops"/>
      </security-setting>
      <security-setting match="#"/>
    </security-settings>

