# Build outputs
target/
**/target/
build/
out/
__pycache__/
*.pyc

# Runtime state and secrets
runtime/
*.pid
*.log
*.env
*.key
*.pem

# Sanitized PT build logs are versioned evidence. Runtime logs remain ignored.
!evidence/01_PT/*/evidence/logs/
!evidence/01_PT/*/evidence/logs/PT-*-build.log

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store

# Large master assets are managed and verified outside Git.
data/master/

# Maven wrapper bootstraps from the pinned distribution URL.
.mvn/wrapper/maven-wrapper.jar
