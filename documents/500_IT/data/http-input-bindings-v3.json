  "semantic_to_http": {
    "token": "operation_token",
    "version": "expected_version",
    "password_confirm": "password_confirmation"
  },
  "routes": {
    "UCR": {
      "entry": "POST /admin/users/new",
      "fields": [
        "username",
        "password",
        "password_confirmation",
        "role",
        "enabled",
        "operation_token",
        "_csrf"
      ]
    },
    "UST_URL_UPW_ULK": {
      "entry": "POST /admin/users/201",
      "fields": [
        "operation",
        "id",
        "expected_version",
        "operation_token",
        "confirm",
        "enabled|role|password/password_confirmation",
        "_csrf"
      ]
    },
    "QSB": {
      "entry": "POST /questions/new",
      "fields": [
        "question",
        "operation_token",
        "_csrf"
      ]
    },
    "NTC": {
      "entry": "POST /notifications/701",
      "fields": [
        "operation=CANCEL",
        "id=701",
        "operation_token",
        "confirm=true",
        "_csrf"
      ]
    },
    "QDL": {
      "entry": "POST /questions/501",
      "fields": [
        "operation=DELETE",
        "id=501",
        "operation_token",
        "confirm=true",
        "_csrf"
      ]
    }
  },
  "csrf": "hidden parameterNameは実GETの_csrf.parameterName/tokenを読み、同origin/sessionで送る。現在既定_csrfを最終Security設定と照合、欠落を独自発行しない。",
  "state": "SOURCE_INPUT_BINDINGS_NOT_EXPECTED_ORACLE",
  "final_reconciliation": "DEP-REBASE。field名が変わればSS意味/閉formとの整合をレビューしbinding更新、未知名を通すfallback0。",
  "query_rules": {
    "UserSearch": "username/role/state/page。usernamePrefixやpageSizeをHTTPに送らない。",
    "LogSearch": "q/log_type/action/path/level/from/to/page、dateというfieldは無い。",
    "Scenario": "GET /search、q/game/speaker/chapter/entry_type/voice/page。",
    "Notification_Question": "pageSizeはwire固定値でHTTP入力ではない。",
    "media": "Rangeはheader、logicalID/type/dispositionはpathから導出、架空Disposition queryやvideoId queryを送らない。",
    "category_section": "pathsegmentを一回UTF8-percentencode、同名queryを付けない。"
  }
